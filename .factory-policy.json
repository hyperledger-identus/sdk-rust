{
  "schemaVersion": 1,
  "repository": "hyperledger-identus/sdk-rust",
  "integrationBranch": "develop",
  "reservedBranches": ["main"],
  "runtime": {
    "piVersion": "0.84.2",
    "nodeMajor": 24,
    "configurationIsGuidance": true
  },
  "delivery": {
    "defaultProfile": "production-ready",
    "qualityTargetPercent": 70,
    "mandatoryInvariantPercent": 100,
    "maximumAutomaticReviewRounds": 1,
    "parentCandidates": 1,
    "managedWorktrees": 2
  },
  "worktrees": {
    "rootRelativeToCommonCheckout": "tmp/worktrees/factory",
    "retentionDays": 7
  },
  "cache": {
    "sccacheLocal": "10G",
    "sccacheHosted": "2G",
    "targetsAreWorktreeLocal": true,
    "piPackages": {
      "schemaVersion": 1,
      "rootKind": "repository-sibling",
      "projectLink": ".pi/npm",
      "manifest": ".pi/package-runtime/package.json",
      "lock": ".pi/package-runtime/package-lock.json",
      "lifecycleScripts": "disabled",
      "automaticPruning": false
    }
  },
  "metrics": {
    "schema": "docs/factory/work-item-metrics-v1.schema.json",
    "privateStore": "sdk-rust-factory/metrics-v1",
    "retentionDays": 90,
    "publicMarker": "sdk-rust-factory-metrics:v1",
    "defaultSchemaVersion": 2,
    "versions": {
      "1": {
        "schema": "docs/factory/work-item-metrics-v1.schema.json",
        "privateStore": "sdk-rust-factory/metrics-v1",
        "publicMarker": "sdk-rust-factory-metrics:v1"
      },
      "2": {
        "schema": "docs/factory/work-item-metrics-v2.schema.json",
        "privateStore": "sdk-rust-factory/metrics-v2",
        "publicMarker": "sdk-rust-factory-metrics:v2"
      }
    },
    "maximumPublicBytes": 8192
  },
  "supervisor": {
    "privateStore": "sdk-rust-factory/supervisor-v1",
    "maximumEnvelopeBytes": 16384,
    "maximumHandoffBytes": 32768,
    "maximumPromptBytes": 65536,
    "maximumSessionBytes": 33554432,
    "maximumEventBytes": 33554432,
    "heartbeatIntervalSeconds": 5,
    "terminationGraceSeconds": 5,
    "roleTools": {
      "planner": ["read", "grep", "find", "ls", "bash", "edit", "write"],
      "developer": ["read", "grep", "find", "ls", "bash", "edit", "write"],
      "reviewer": ["read", "grep", "find", "ls"],
      "quality": ["read", "grep", "find", "ls", "bash", "edit", "write"]
    }
  },
  "ci": {
    "requiredPullRequestGate": "fast",
    "slowSchedule": "weekly-or-manual",
    "unknownDiff": "recommend-complete-slow"
  }
}
