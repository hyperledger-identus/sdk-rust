#!/usr/bin/env bash

set -euo pipefail
export OPENSPEC_TELEMETRY=${OPENSPEC_TELEMETRY:-0}

factory_root=$(git rev-parse --show-toplevel 2>/dev/null || pwd)

fail() {
  printf 'factory: %s\n' "$1" >&2
  exit 1
}

nix_binary() {
  if command -v nix >/dev/null 2>&1; then
    command -v nix
  elif [[ -x /nix/var/nix/profiles/default/bin/nix ]]; then
    printf '%s\n' /nix/var/nix/profiles/default/bin/nix
  else
    return 1
  fi
}

run_openspec() {
  if command -v openspec >/dev/null 2>&1; then
    openspec "$@"
    return
  fi

  local nix_cmd
  nix_cmd=$(nix_binary) || fail "OpenSpec is unavailable; install Nix or enter the devshell"
  "$nix_cmd" develop "$factory_root" --command openspec "$@"
}

validate_all() {
  run_openspec validate --all --strict --no-interactive
}

check_factory() {
  "$factory_root/scripts/check-factory.sh" "$factory_root"
  run_openspec doctor
  validate_all
}

research_ready_change() {
  local change_name=${1:-}
  [[ -n "$change_name" ]] || fail "research-ready requires an active OpenSpec change name"

  local change_root="$factory_root/openspec/changes/$change_name"
  [[ -d "$change_root" ]] || fail "active change not found: $change_name"

  check_factory
  run_openspec status --change "$change_name"
  run_openspec validate "$change_name" --type change --strict --no-interactive
  "$factory_root/scripts/check-research-readiness.py" "$factory_root" \
    --change "$change_name" --require-ready
  "$factory_root/scripts/check-constraints.py" "$factory_root" \
    --change "$change_name" --require-ready

  printf 'factory: research is ready: %s\n' "$change_name"
}

constraints_ready_change() {
  local change_name=${1:-}
  [[ -n "$change_name" ]] || fail "constraints-ready requires an active OpenSpec change name"

  local change_root="$factory_root/openspec/changes/$change_name"
  [[ -d "$change_root" ]] || fail "active change not found: $change_name"

  check_factory
  run_openspec status --change "$change_name"
  run_openspec validate "$change_name" --type change --strict --no-interactive
  "$factory_root/scripts/check-constraints.py" "$factory_root" \
    --change "$change_name" --require-ready

  printf 'factory: constraints are ready: %s\n' "$change_name"
}

ready_change() {
  local change_name=${1:-}
  [[ -n "$change_name" ]] || fail "ready requires an active OpenSpec change name"

  local change_root="$factory_root/openspec/changes/$change_name"
  [[ -d "$change_root" ]] || fail "active change not found: $change_name"

  check_factory
  run_openspec status --change "$change_name"
  run_openspec validate "$change_name" --type change --strict --no-interactive
  "$factory_root/scripts/check-research-readiness.py" "$factory_root" \
    --change "$change_name" --require-ready
  "$factory_root/scripts/check-constraints.py" "$factory_root" \
    --change "$change_name" --require-ready
  node "$factory_root/scripts/factory-tools/preflight.mjs" \
    "$change_name" --validate-receipt

  if grep -n '^- \[ \]' "$change_root/tasks.md"; then
    fail "change has incomplete tasks: $change_name"
  fi

  printf 'factory: change is ready: %s\n' "$change_name"
}

print_receipt() {
  local change_name=${1:-}
  [[ -n "$change_name" ]] || fail "receipt requires an active OpenSpec change name"
  ready_change "$change_name" >/dev/null

  local branch head base_ref base_sha
  branch=$(git -C "$factory_root" symbolic-ref --quiet --short HEAD || printf 'detached')
  head=$(git -C "$factory_root" rev-parse HEAD)

  if git -C "$factory_root" show-ref --verify --quiet refs/remotes/origin/develop; then
    base_ref=origin/develop
  elif git -C "$factory_root" show-ref --verify --quiet refs/heads/develop; then
    base_ref=develop
  else
    fail "cannot resolve develop for the evidence receipt"
  fi
  base_sha=$(git -C "$factory_root" merge-base "$base_ref" HEAD)

  printf 'Change: %s\n' "$change_name"
  printf 'Branch: %s\n' "$branch"
  printf 'Head SHA: %s\n' "$head"
  printf 'Develop merge base: %s\n' "$base_sha"
  printf 'Factory contract: passed\n'
  printf 'Product-specific gates: not asserted; attach their outputs separately\n'
}

archive_change() {
  local change_name=${1:-}
  [[ -n "$change_name" ]] || fail "archive requires an active OpenSpec change name"

  local change_root="$factory_root/openspec/changes/$change_name"
  [[ -d "$change_root" ]] || fail "active change not found: $change_name"

  local archive_root="$factory_root/openspec/changes/archive"
  [[ -d "$archive_root" && ! -L "$archive_root" ]] \
    || fail "archive root is not a regular directory: ${archive_root#"$factory_root/"}"

  local archive_candidate
  local -a archive_before=()
  for archive_candidate in "$archive_root"/????-??-??-"$change_name"; do
    if [[ -e "$archive_candidate" || -L "$archive_candidate" ]]; then
      archive_before+=("$archive_candidate")
    fi
  done

  # Preserve the early collision guard for the pinned OpenSpec version's UTC
  # destination, but do not use this prediction as the completion receipt.
  local current_utc_date current_utc_archive
  current_utc_date=$(LC_ALL=C date -u +%F) || fail "cannot determine current UTC date"
  current_utc_archive="$archive_root/$current_utc_date-$change_name"
  if [[ -e "$current_utc_archive" || -L "$current_utc_archive" ]]; then
    fail "archive destination already exists: ${current_utc_archive#"$factory_root/"}"
  fi

  ready_change "$change_name"
  "$factory_root/scripts/check-openspec-archive.py" "$factory_root" --change "$change_name"
  run_openspec archive "$change_name" --yes

  if [[ -e "$change_root" || -L "$change_root" ]]; then
    fail "OpenSpec returned without removing active change: $change_name"
  fi

  local archive_was_present
  local -a archive_new=()
  for archive_candidate in "$archive_root"/????-??-??-"$change_name"; do
    if [[ ! -e "$archive_candidate" && ! -L "$archive_candidate" ]]; then
      continue
    fi

    archive_was_present=false
    local previous_archive
    if [[ ${archive_before[0]+set} == set ]]; then
      for previous_archive in "${archive_before[@]}"; do
        if [[ "$archive_candidate" == "$previous_archive" ]]; then
          archive_was_present=true
          break
        fi
      done
    fi
    if [[ "$archive_was_present" == false ]]; then
      archive_new+=("$archive_candidate")
    fi
  done

  if (( ${#archive_new[@]} != 1 )); then
    fail "OpenSpec returned with ${#archive_new[@]} new matching archives for $change_name; expected exactly one"
  fi

  local expected_archive=${archive_new[0]}
  if [[ ! -d "$expected_archive" || -L "$expected_archive" ]]; then
    fail "new archive is not a regular directory: ${expected_archive#"$factory_root/"}"
  fi

  local required_artifact
  for required_artifact in .openspec.yaml proposal.md research.md constraints.md design.md tasks.md; do
    if [[ ! -f "$expected_archive/$required_artifact" || -L "$expected_archive/$required_artifact" ]]; then
      fail "archived change is missing regular artifact: $required_artifact"
    fi
  done
  if [[ ! -d "$expected_archive/specs" || -L "$expected_archive/specs" ]]; then
    fail "archived change is missing regular capability directory: specs"
  fi

  check_factory
  printf 'factory: change archived safely: %s\n' "$change_name"
}

doctor() {
  check_factory

  local branch
  branch=$(git -C "$factory_root" symbolic-ref --quiet --short HEAD || printf 'detached')
  case "$branch" in
    main)
      fail "main is reserved; create a focused branch and worktree from develop"
      ;;
    develop)
      printf 'factory: warning: develop is the integration branch; implementation belongs on a focused branch\n' >&2
      ;;
    detached)
      printf 'factory: warning: detached HEAD cannot prove a feature-branch workflow\n' >&2
      ;;
    *)
      if git -C "$factory_root" show-ref --verify --quiet refs/remotes/origin/develop; then
        git -C "$factory_root" merge-base --is-ancestor origin/develop HEAD \
          || fail "current branch does not descend from origin/develop"
      fi
      ;;
  esac

  printf 'factory: doctor passed on %s\n' "$branch"
}

status() {
  printf 'Branch: '
  git -C "$factory_root" symbolic-ref --quiet --short HEAD || printf 'detached\n'
  printf 'Head: '
  git -C "$factory_root" rev-parse HEAD
  git -C "$factory_root" status --short --branch
  run_openspec list
}

usage() {
  cat <<'USAGE'
Usage: scripts/factory <command> [change]

Commands:
  doctor              Validate tools, contracts and the local branch/worktree
  status              Show Git and active OpenSpec state
  validate [change]   Strictly validate one change or every change and spec
  check               Run the CI-safe factory and OpenSpec structural gates
  research-ready <change>
                      Require reviewed research with zero declared blockers
  constraints-ready <change>
                      Require explicit constraint impact and material authority
  preflight <change> --issue N [--write|--validate-receipt]
                      Prove OpenSpec was ready before implementation began
  audit [options]     Audit pinned Pi runtime and bounded repository policy
  plan [options]      Derive immutable fast/slow target routing from exact SHAs
  metrics [options]   Validate, store, render or publish bounded work metrics
  worktrees [options] Audit or mutate only managed issue worktrees
  ready <change>      Require valid artifacts and every task to be complete
  receipt <change>    Run readiness and print immutable handoff identifiers
  archive <change>    Preflight, archive and validate a completed change
  help                Show this help
USAGE
}

command_name=${1:-help}
shift || true

case "$command_name" in
  doctor)
    doctor
    ;;
  status)
    status
    ;;
  validate)
    if (($# > 0)); then
      run_openspec validate "$1" --type change --strict --no-interactive
    else
      validate_all
    fi
    ;;
  check)
    check_factory
    ;;
  research-ready)
    research_ready_change "${1:-}"
    ;;
  constraints-ready)
    constraints_ready_change "${1:-}"
    ;;
  preflight)
    node "$factory_root/scripts/factory-tools/preflight.mjs" "$@"
    ;;
  audit)
    node "$factory_root/scripts/factory-tools/audit-pi.mjs" "$@"
    ;;
  plan)
    node "$factory_root/scripts/ci/target-plan.mjs" "$@"
    ;;
  metrics)
    node "$factory_root/scripts/factory-tools/metrics.mjs" "$@"
    ;;
  worktrees)
    node "$factory_root/scripts/worktree-lifecycle.mjs" "$@"
    ;;
  ready)
    ready_change "${1:-}"
    ;;
  receipt)
    print_receipt "${1:-}"
    ;;
  archive)
    archive_change "${1:-}"
    ;;
  help | --help | -h)
    usage
    ;;
  *)
    usage >&2
    fail "unknown command: $command_name"
    ;;
esac
